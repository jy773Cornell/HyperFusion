<?xml version="1.0"?>
<!-- Camera / sensor collision payload on tool0.
     mesh: real CAD STL (metres), flange-aligned — preferred.
     hemisphere: unit bowl scaled by radius_m (flat on flange, dome +tool0 Z).
     sphere / box: simple primitives. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="hyperfusion_tool_payload"
               params="tf_prefix shape radius_m box_x_m box_y_m box_z_m mesh_dir mesh_file collision_gap_m origin_x_m origin_y_m origin_z_m origin_roll_rad origin_pitch_rad origin_yaw_rad">

    <link name="${tf_prefix}hyperfusion_tool_payload">
      <visual name="hyperfusion_tool_payload_visual">
        <xacro:if value="${shape == 'mesh'}">
          <!-- CAD was pan-180° off in tool0 XY → rotate about Z by π. -->
          <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
          <geometry>
            <mesh filename="file://${mesh_dir}${mesh_file}" scale="1 1 1"/>
          </geometry>
        </xacro:if>
        <xacro:if value="${shape == 'hemisphere'}">
          <!-- Unit bowl (flat at z=1, apex at z=0): flat on flange, dome along +tool0 Z. -->
          <origin xyz="0 0 ${radius_m}" rpy="${pi} 0 0"/>
          <geometry>
            <mesh filename="file://${mesh_dir}tool_payload_hemisphere.stl"
                  scale="${radius_m} ${radius_m} ${radius_m}"/>
          </geometry>
        </xacro:if>
        <xacro:if value="${shape == 'box'}">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <box size="${box_x_m} ${box_y_m} ${box_z_m}"/>
          </geometry>
        </xacro:if>
        <xacro:if value="${shape == 'sphere'}">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <sphere radius="${radius_m}"/>
          </geometry>
        </xacro:if>
        <material name="hyperfusion_tool_payload_visual">
          <color rgba="0.15 0.85 1.0 0.55"/>
        </material>
      </visual>

      <collision>
        <xacro:if value="${shape == 'mesh'}">
          <!-- CAD was pan-180° off in tool0 XY → rotate about Z by π. -->
          <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
          <geometry>
            <mesh filename="file://${mesh_dir}${mesh_file}" scale="1 1 1"/>
          </geometry>
        </xacro:if>
        <xacro:if value="${shape == 'hemisphere'}">
          <origin xyz="0 0 ${radius_m + collision_gap_m}" rpy="${pi} 0 0"/>
          <geometry>
            <mesh filename="file://${mesh_dir}tool_payload_hemisphere.stl"
                  scale="${radius_m} ${radius_m} ${radius_m}"/>
          </geometry>
        </xacro:if>
        <xacro:if value="${shape == 'box'}">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <box size="${box_x_m} ${box_y_m} ${box_z_m}"/>
          </geometry>
        </xacro:if>
        <xacro:if value="${shape == 'sphere'}">
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <geometry>
            <sphere radius="${radius_m}"/>
          </geometry>
        </xacro:if>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.35"/>
        <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
      </inertial>
    </link>

    <joint name="${tf_prefix}hyperfusion_tool_payload_joint" type="fixed">
      <parent link="${tf_prefix}tool0"/>
      <child link="${tf_prefix}hyperfusion_tool_payload"/>
      <origin xyz="${origin_x_m} ${origin_y_m} ${origin_z_m}"
              rpy="${origin_roll_rad} ${origin_pitch_rad} ${origin_yaw_rad}"/>
    </joint>

  </xacro:macro>

</robot>
