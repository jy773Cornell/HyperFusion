# HyperFusion — root .gitignore (Windows native app + Python sidecars)

# --- OS / shell ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# --- Editors / IDEs ---
.vs/
.idea/
*.code-workspace

# Cursor (keep shared agent rules under .cursor/rules/)
.cursor/
!.cursor/rules/
!.cursor/rules/**

# Visual Studio / MSVC (local machine files)
*.vcxproj.user
*.vcxproj.filters.user
*.sln.docstates
*.suo
*.user
*.userosscache
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf
*.ipch

# Qt / Qt Creator (local machine files)
*.pro.user
*.pro.user.*
*.qbs.user
*.qmlc
*.jsc
CMakeLists.txt.user*

# --- Build trees / generated ---
**/.qt/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/CTestTestfile.cmake
**/install_manifest.txt
**/compile_commands.json
**/Testing/
**/app_autogen/
**/build/
**/build-*/
**/cmake-build-*/
**/out/

# MSVC / link artifacts (outside ignored build trees)
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.exe.manifest

# Ninja
**/*.ninja
**/.ninja_deps
**/.ninja_log

# --- Python ---
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
*.egg-info/
**/.cache/
**/.cache/huggingface/
**/.cache/torch/

# --- Sidecar weights / vendor clones (do not commit) ---
# SAM2 / GSAM2
app/sidecars/gsam2/checkpoints/*.pt
app/sidecars/gsam2/checkpoints/*.pth
app/sidecars/gsam2/checkpoints/*.ckpt
app/sidecars/gsam2/.cache/
app/sidecars/gsam2/venv/
resources/sam2/

# Preview dumps
app/calibration/multiview/**/undistort_preview/
app/calibration/multiview/**/results/undistort_preview/

# BFS stills (multi-GB). Keep board.yaml / scripts / small YAML results.
app/calibration/multiview/bfs_cal/checkerboard/

# DLP / FPP geometry bursts (TIFFs + per-frame JSON). Keep scripts + stereo YAML.
app/calibration/multiview/dlp_cal/checkerboard/
app/calibration/multiview/dlp_cal/results/depth_smoke_*/

# Legacy FPP plane-calib path (removed tree; ignore leftovers)
app/calibration/multiview/fpp_cal/checkerboard/
app/calibration/multiview/FPP/*
!app/calibration/multiview/FPP/README.md
!app/calibration/multiview/FPP/fpp_calib_index.json
!app/calibration/multiview/FPP/fpp_calib_quality.json

# Bundle-adjustment corner cache (large). Keep scripts + small YAML/JSON results.
app/calibration/multiview/ba/cache/

# Common binary capture / reconstruction dumps under calibration
app/calibration/multiview/**/*.tif
app/calibration/multiview/**/*.tiff
app/calibration/multiview/**/*.npz
app/calibration/multiview/**/*.ply
app/calibration/multiview/**/*.pt
app/calibration/multiview/**/*.pth
app/calibration/multiview/**/*.ckpt

# --- Logs / temp ---
*.log
*.tmp
*.temp
*.swp
*.swo

# --- Docs / installer (local, not versioned here) ---
docs/
dist/
tools/vendor_installers/**
!tools/vendor_installers/install_order.txt
