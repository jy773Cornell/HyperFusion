# --- OS / shell ---
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.stackdump

# --- Editors / IDEs ---
.vs/
.idea/
*.code-workspace

# Cursor (keep shared agent rules under .cursor/rules/)
.cursor/
!.cursor/rules/
!.cursor/rules/**

# Visual Studio / MSVC (local machine files)
*.vcxproj.user
*.vcxproj.filters.user
*.sln.docstates
*.suo
*.user
*.userosscache
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf
*.ipch

# Qt / Qt Creator (local machine files)
*.pro.user
*.pro.user.*
*.qbs.user
*.qmlc
*.jsc
CMakeLists.txt.user*

# CMake / build trees (generated)
**/.qt/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/CTestTestfile.cmake
**/install_manifest.txt
**/compile_commands.json
**/Testing/
**/app_autogen/

# Common build output folder names
**/build/
**/build-*/
**/cmake-build-*/
**/out/

# MSVC / link artifacts (outside ignored build trees)
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.exe.manifest

# Ninja / Makefile artifacts inside build trees
**/*.ninja
**/.ninja_deps
**/.ninja_log

# --- Python (GSAM2 WSL sidecar, scripts) ---
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/
*.egg-info/
**/.cache/huggingface/
**/.cache/torch/

# SAM2 / GSAM2 model weights (large; see app/sidecars/gsam2/envsetup.md)
app/sidecars/gsam2/checkpoints/*.pt
app/sidecars/gsam2/checkpoints/*.pth
app/sidecars/gsam2/checkpoints/*.ckpt
app/sidecars/gsam2/.cache/
app/sidecars/gsam2/venv/
resources/sam2/

# --- HyperFusion local runtime / capture data ---
/processing/
app/calibration/multiview/results/undistort_preview/
app/calibration/multiview/bfs_cal/results/undistort_preview/
# BFS stills (multi-GB). Keep board.yaml / scripts / small YAML results.
app/calibration/multiview/bfs_cal/checkerboard/
# FPP geometry bursts (~15 GB TIFFs). Keep README + manifest + stereo YAML.
app/calibration/multiview/fpp_cal/checkerboard/*/
!app/calibration/multiview/fpp_cal/checkerboard/README.md
!app/calibration/multiview/fpp_cal/checkerboard/manifest.json
app/calibration/multiview/fpp_cal/results/depth_smoke_*/
# Legacy FPP plane-calib path (removed); keep ignore if leftovers appear.
app/calibration/multiview/FPP/*
!app/calibration/multiview/FPP/README.md
!app/calibration/multiview/FPP/fpp_calib_index.json
!app/calibration/multiview/FPP/fpp_calib_quality.json

# Logs / temp
*.log
*.tmp
*.temp
*.swp
*.swo

# Documentation (local / generated; not versioned here)
docs/

# Installer staging and bundled vendor SDK binaries (do not commit)
dist/
tools/vendor_installers/**
!tools/vendor_installers/install_order.txt